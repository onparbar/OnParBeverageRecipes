{
  "manifest_version": 3,
  "name": "On Par Vendor Cart Builder",
  "version": "1.2.12",
  "description": "Builds review-only BEES, Proof, and OHLQ carts from approved On Par orders.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://onparbev.com/*",
    "https://mybeesapp.com/*",
    "https://*.sgproof.com/*",
    "https://*.ohlq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://onparbev.com/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mybeesapp.com/*"],
      "js": ["checkout-review.js", "bees-cart.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.sgproof.com/*", "https://*.ohlq.com/*"],
      "js": ["checkout-review.js", "vendor-cart.js"],
      "run_at": "document_idle"
    }
  ]
}
