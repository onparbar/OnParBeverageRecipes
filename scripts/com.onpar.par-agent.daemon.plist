<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.onpar.par-agent</string>
  <key>UserName</key>
  <string>onpar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/onpar/OnParBeverageRecipes-service/.deploy/run-par-agent.sh</string>
    <string>--dry-run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/onpar/OnParBeverageRecipes-service/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ONPAR_SERVICE_DIR</key>
    <string>/Users/onpar/OnParBeverageRecipes-service/current</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/onpar/OnParBeverageRecipes-service/logs/par-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/onpar/OnParBeverageRecipes-service/logs/par-agent.err.log</string>
</dict>
</plist>
