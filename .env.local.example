# Provi session bridge
# Copy this file to `.env.local` and replace the placeholder values.

DASHBOARD_PASSWORD=
EMPLOYEE_DASHBOARD_PASSWORD=

# Optional persistent location for shared inventory and Monday snapshots.
# Defaults to data/inventory-state.json in the running service.
INVENTORY_STATE_PATH=

PROVI_COOKIE_HEADER=
PROVI_RETAILER_CONTEXT=

# Optional OHLQ / Provi account details
PROVI_OHLQ_ACCOUNT_NUMBER=
PROVI_OHLQ_DISTRIBUTOR_ID=
PROVI_OHLQ_DISTRIBUTOR_ACCOUNT_ID=
PROVI_OHLQ_RETAILER_DISTRIBUTOR_ID=

# Local PMB / TTG keg levels
PMB_API_BASE_URL=
PMB_API_USERNAME=admin
PMB_API_PASSWORD=admin
PMB_API_CLIENT_ID=910423
PMB_API_CLIENT_NAME=PourMyBeer API
PMB_KEG_DEVICE_ID=66952915841408

# Untappd for Business (API Access Tokens in the Untappd Business account)
UNTAPPD_BUSINESS_EMAIL=
UNTAPPD_BUSINESS_API_TOKEN=

# Central shared dashboard state (server-side only; never expose the secret in browser code)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Legacy service-role JWTs are also supported
# SUPABASE_ALLOW_INSECURE_LOCALHOST=true  # Local Supabase development only

# Provi diagnostic capture retention (sensitive fields are redacted automatically)
PROVI_CAPTURE_RETENTION_DAYS=30
PROVI_CAPTURE_MAX_FILES=20
